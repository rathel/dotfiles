[Unit]
Description=Mount Dropbox with rclone
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Keep this optional unit quiet when rclone is not installed.
ExecCondition=env sh -c 'command -v rclone >/dev/null 2>&1'
ExecStartPre=mkdir -p %h/Dropbox
ExecStart=env rclone mount --vfs-cache-mode full --vfs-cache-max-size 10G --vfs-cache-max-age 1h dropbox: %h/Dropbox
ExecStop=env fusermount3 -u %h/Dropbox
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
