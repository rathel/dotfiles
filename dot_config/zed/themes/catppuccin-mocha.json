          {
            "cursor": "#f38ba8",
            "selection": "#f38ba84d",
            "background": "#f38ba8"
          },
          {
            "cursor": "#45475a",
            "selection": "#45475a4d",
            "background": "#45475a"
          },
          {
            "cursor": "#6c7086",
            "selection": "#6c70864d",
            "background": "#6c7086"
          },
          {
            "cursor": "#89b4fa",
            "selection": "#89b4fa4d",
            "background": "#89b4fa"
          }
