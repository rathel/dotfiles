          "#585b70",
          "#45475a",
          "#f9e2af",
          "#f38ba8",
          "#89b4fa",
          "#6c7086"
        ],

        "vim.mode.text": "#1e1e2e",
        "vim.normal.foreground": "#1e1e2e",
