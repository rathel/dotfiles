          "text": { "color": "#cdd6f4" },
          "text.literal": { "color": "#89b4fa" },
          "title": { "color": "#89b4fa", "font_weight": 700 },
          "type": { "color": "#74c7ec" },
          "type.builtin": { "color": "#74c7ec", "font_style": "italic" },
          "variable": { "color": "#cdd6f4" },
          "variable.builtin": { "color": "#89b4fa" },
