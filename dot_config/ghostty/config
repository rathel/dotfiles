# ~/.config/ghostty/config

# Font
font-family = "IosevkaTerm Nerd Font"
font-style = bold
font-size = 12

# UI / behavior
background-opacity = 1.0
window-padding-x = 10
window-padding-y = 10

# Tabs: compact, flat, and always visible, like kitty's tab bar.
# GTK tabs cannot reproduce kitty's powerline shape exactly.
window-show-tab-bar = never
gtk-tabs-location = top
gtk-wide-tabs = false
gtk-toolbar-style = flat
gtk-titlebar-style = native
# Ghostty measures scrollback in bytes; 10 MB comfortably covers 10,000 lines.
scrollback-limit = 10000000
copy-on-select = clipboard
confirm-close-surface = always
bell-features = no-system,no-audio,attention,title,no-border

# Cursor
cursor-style = block
cursor-style-blink = false

# Handy keybinds
keybind = ctrl+shift+enter=new_split:auto
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+bracket_right=next_tab
keybind = ctrl+shift+bracket_left=previous_tab

# Keep the window title blank.
title = " "

# Nord - Polar Night
theme = nord-polar-night.conf
