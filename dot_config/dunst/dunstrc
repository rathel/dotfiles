[global]
monitor = 0
follow = keyboard
width = (300, 800)
height = (100, 400)
origin = top-right
offset = (17,17)
scale = 1
gap_size = 10
indicate_hidden = yes
frame_width = 0
corner_radius = 0
padding = 12
horizontal_padding = 12
enable_posix_regex = true
font = "Monaspace Neon NF"
line_height = 3
alignment = left
stack_duplicates = true
hide_duplicate_count = false
max_icon_size = 128
markup = full
format = "<b>%a</b>\n%s\n%b"
progress_bar = true
progress_bar_height = 10
progress_bar_corner_radius = 4
progress_bar_frame_width = 1
separator_height = 2
ignore_dbusclose = false
force_xwayland = false
# Catppuccin Mocha
frame_color = "#89B4FA"
highlight = "#89B4FA"
separator_color = "#45475A"

[experimental]
per_monitor_dpi = false

[urgency_low]
timeout = 2
background = "#1E1E2EEE"
foreground = "#CDD6F4"
frame_color = "#585b70"

[urgency_normal]
timeout = 3
background = "#1E1E2E80"
foreground = "#CDD6F4"
frame_color = "#89B4FA"

[urgency_critical]
timeout = 4
background = "#1E1E2EEE"
foreground = "#BAC2DE"
frame_color = "#F38BA8"
