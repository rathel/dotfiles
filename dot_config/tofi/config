# Forest Green theme for Tofi
font = "Monaspace Neon NF"
font-size = 14

background-color = #192324
text-color = #dce8e1
prompt-text = "apps: "
prompt-color = #f3f7f5
input-color = #dce8e1
placeholder-color = #a9beb3
default-result-color = #dce8e1
selection-color = #f3f7f5
selection-background = #345b4b
selection-match-color = #6f9a91

outline-width = 0
border-width = 1
border-color = #5a8e73
corner-radius = 0

width = 30%
height = 100%
anchor = left
margin-top = 0
margin-left = 0
padding-top = 12
padding-bottom = 12
padding-left = 16
padding-right = 16

fuzzy-match = true
drun-launch = true
hide-cursor = true
history = true
