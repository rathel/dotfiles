# Catppuccin Mocha theme for Tofi
font = "Monaspace Neon NF"
font-size = 14

background-color = #1e1e2e
text-color = #cdd6f4
prompt-text = "apps: "
prompt-color = #bac2de
input-color = #cdd6f4
placeholder-color = #6c7086
default-result-color = #cdd6f4
selection-color = #bac2de
selection-background = #45475a
selection-match-color = #74c7ec

outline-width = 0
border-width = 1
border-color = #89b4fa
corner-radius = 0

width = 30%
height = 100%
anchor = left
margin-top = 0
margin-left = 0
padding-top = 12
padding-bottom = 12
padding-left = 16
padding-right = 16

fuzzy-match = true
drun-launch = true
hide-cursor = true
history = true
