# TokyoNight Night theme for Tofi
font = "Monaspace Neon NF"
font-size = 14

background-color = #1a1b26
text-color = #c0caf5
prompt-text = "apps: "
prompt-color = #e0e6ff
input-color = #c0caf5
placeholder-color = #565f89
default-result-color = #c0caf5
selection-color = #e0e6ff
selection-background = #33467c
selection-match-color = #7dcfff

outline-width = 0
border-width = 1
border-color = #7aa2f7
corner-radius = 0

width = 30%
height = 100%
anchor = left
margin-top = 0
margin-left = 0
padding-top = 12
padding-bottom = 12
padding-left = 16
padding-right = 16

fuzzy-match = true
drun-launch = true
hide-cursor = true
history = true
