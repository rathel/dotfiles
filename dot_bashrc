# .bashrc

# Source global definitions
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# User specific environment
if ! [[ "$PATH" =~ "$HOME/.local/bin:$HOME/bin:" ]]; then
    PATH="$HOME/.local/bin:$HOME/bin:$PATH"
fi
export PATH

# Use the running Emacs daemon for commands that need the default editor.
# The empty alternate editor starts a daemon if the user service is not up.
export EDITOR="emacsclient --tty --alternate-editor="
export VISUAL="emacsclient --tty --alternate-editor="
export GIT_EDITOR="emacsclient --tty --alternate-editor="
export SUDO_EDITOR="emacsclient --tty --alternate-editor="

# Uncomment the following line if you don't like systemctl's auto-paging feature:
# export SYSTEMD_PAGER=

# User specific aliases and functions
if [ -d ~/.bashrc.d ]; then
    for rc in ~/.bashrc.d/*; do
        if [ -f "$rc" ]; then
            . "$rc"
        fi
    done
fi
unset rc

# Start Fish for interactive Bash sessions. Do not use an exported guard here:
# Herdr inherits the environment from Fish, so a guard would keep every new
# tab in Bash. A Bash explicitly launched from Fish is left alone instead.
if [[ $- == *i* ]] && [[ -t 0 && -t 1 ]] && command -v fish >/dev/null 2>&1; then
    _bashrc_parent_shell=$(ps -p "$PPID" -o comm= 2>/dev/null)
    if [[ $_bashrc_parent_shell != fish ]]; then
        unset BASHRC_FISH_GUARD
        exec fish
    fi
    unset _bashrc_parent_shell
fi
. "$HOME/.cargo/env"

# QODER_DISPATCHER_PATH v1
_qoder_dispatcher_entry="$HOME/.qoder/entry"
_qoder_dispatcher_rest=${PATH-}
_qoder_dispatcher_tail=
while :; do
  case $_qoder_dispatcher_rest in
    *:*) _qoder_dispatcher_part=${_qoder_dispatcher_rest%%:*}; _qoder_dispatcher_rest=${_qoder_dispatcher_rest#*:}; _qoder_dispatcher_more=1 ;;
    *) _qoder_dispatcher_part=$_qoder_dispatcher_rest; _qoder_dispatcher_more= ;;
  esac
  if [ "$_qoder_dispatcher_part" != "$_qoder_dispatcher_entry" ]; then
    _qoder_dispatcher_tail="${_qoder_dispatcher_tail}:${_qoder_dispatcher_part}"
  fi
  [ -n "$_qoder_dispatcher_more" ] || break
done
PATH="${_qoder_dispatcher_entry}${_qoder_dispatcher_tail}"
export PATH
unset _qoder_dispatcher_entry _qoder_dispatcher_rest _qoder_dispatcher_tail _qoder_dispatcher_part _qoder_dispatcher_more
# END QODER_DISPATCHER_PATH v1


# Added by Antigravity CLI installer
export PATH="$HOME/.local/bin:$PATH"
