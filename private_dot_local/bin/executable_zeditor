#!/usr/bin/env bash
set -euo pipefail

readonly system_zeditor=/usr/bin/zeditor

if [[ ! -x "$system_zeditor" ]]; then
  printf 'zeditor: %s is not installed or executable\n' "$system_zeditor" >&2
  exit 127
fi

# Zed parses every font exposed by fontconfig during startup. Keep its font set
# focused so the full local Nerd Fonts collection does not block the UI.
readonly cache_root="${XDG_CACHE_HOME:-$HOME/.cache}/zeditor-fontconfig"
readonly fonts_dir="$cache_root/fonts-v1"
readonly font_cache_dir="$cache_root/cache-v1"
readonly fontconfig_file="$cache_root/fonts-v1.conf"

mkdir -p "$fonts_dir" "$font_cache_dir"

link_font() {
  local source=$1

  if [[ -f "$source" ]]; then
    ln -sfn -- "$source" "$fonts_dir/${source##*/}"
  fi
}

for family in IosevkaNerdFont IosevkaTermNerdFont; do
  for style in Regular Bold Italic BoldItalic; do
    link_font "$HOME/.local/share/fonts/nerdfonts/${family}-${style}.ttf"
  done
done

for name in \
  NotoSans-Regular.ttf \
  NotoSans-Bold.ttf \
  NotoSans-Italic.ttf \
  NotoSans-BoldItalic.ttf \
  NotoSansMono-Regular.ttf \
  NotoSansMono-Bold.ttf \
  NotoSerif-Regular.ttf \
  NotoSerif-Bold.ttf \
  NotoSerif-Italic.ttf \
  NotoSerif-BoldItalic.ttf \
  NotoColorEmoji.ttf \
  NotoSansSymbols-Regular.ttf \
  NotoSansSymbols2-Regular.ttf \
  NotoSansMath-Regular.ttf
do
  link_font "/usr/share/fonts/noto/$name"
done

if [[ ! -f "$fontconfig_file" ]]; then
  temp_config="$(mktemp "$cache_root/fonts-v1.conf.XXXXXX")"
  trap 'rm -f -- "$temp_config"' EXIT

  cat >"$temp_config" <<EOF
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<fontconfig>
  <dir>/usr/share/fonts/TTF</dir>
  <dir>/usr/share/fonts/Adwaita</dir>
  <dir>/usr/share/fonts/liberation</dir>
  <dir>$fonts_dir</dir>
  <cachedir>$font_cache_dir</cachedir>
</fontconfig>
EOF

  mv -f -- "$temp_config" "$fontconfig_file"
  trap - EXIT
fi

export FONTCONFIG_FILE="$fontconfig_file"
export FONTCONFIG_PATH=/etc/fonts

exec "$system_zeditor" "$@"
