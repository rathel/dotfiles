#!/usr/bin/env bash
set -euo pipefail

# Download the latest Microsoft Edge Stable .deb and install its files under
# ~/Applications/Utilities/microsoft-edge without requiring root privileges.

readonly repo_url="https://packages.microsoft.com/repos/edge"
readonly destination="${HOME}/Applications/Utilities/microsoft-edge"
readonly architecture="amd64"

tmp_dir="$(mktemp -d)"
cleanup() {
    rm -rf -- "$tmp_dir"
}
trap cleanup EXIT

for command in curl gzip awk ar tar sha256sum; do
    if ! command -v "$command" >/dev/null 2>&1; then
        printf 'Error: required command not found: %s\n' "$command" >&2
        exit 1
    fi
done

printf 'Checking the latest Microsoft Edge Stable version...\n'
package_info="$(curl --fail --silent --show-error --location --retry 3 \
    "${repo_url}/dists/stable/main/binary-${architecture}/Packages.gz" \
    | gzip -dc \
    | awk -v package='microsoft-edge-stable' -v arch="$architecture" '
        function save() {
            if (name == package && package_arch == arch && filename != "") {
                latest_version = version
                latest_filename = filename
                latest_sha256 = sha256
            }
        }
        /^$/ { save(); name = version = package_arch = filename = sha256 = ""; next }
        /^Package:/ { name = $2 }
        /^Version:/ { version = $2 }
        /^Architecture:/ { package_arch = $2 }
        /^Filename:/ { filename = $2 }
        /^SHA256:/ { sha256 = $2 }
        END { save(); print latest_version "\t" latest_filename "\t" latest_sha256 }
    ')"

IFS=$'\t' read -r version package_path expected_sha256 <<< "$package_info"
if [[ -z "$version" || -z "$package_path" || -z "$expected_sha256" ]]; then
    printf 'Error: could not determine the latest Edge package.\n' >&2
    exit 1
fi

package_file="${tmp_dir}/microsoft-edge.deb"
printf 'Downloading Microsoft Edge %s...\n' "$version"
curl --fail --silent --show-error --location --retry 3 \
    --output "$package_file" "${repo_url}/${package_path}"

actual_sha256="$(sha256sum "$package_file" | awk '{print $1}')"
if [[ "$actual_sha256" != "$expected_sha256" ]]; then
    printf 'Error: downloaded package failed SHA-256 verification.\n' >&2
    exit 1
fi

printf 'Extracting to %s...\n' "$destination"
archive_dir="${tmp_dir}/archive"
extracted_dir="${tmp_dir}/extracted"
mkdir -p "$archive_dir" "$extracted_dir"
(
    cd "$archive_dir"
    ar x "$package_file"
)
data_archive="$(find "$archive_dir" -maxdepth 1 -type f -name 'data.tar.*' -print -quit)"
if [[ -z "$data_archive" ]]; then
    printf 'Error: downloaded package does not contain a data archive.\n' >&2
    exit 1
fi
tar -xf "$data_archive" -C "$extracted_dir"

new_destination="${destination}.new.$$"
rm -rf -- "$new_destination"
mkdir -p "$(dirname "$destination")"
mv -- "$extracted_dir" "$new_destination"
rm -rf -- "$destination"
mv -- "$new_destination" "$destination"

printf 'Microsoft Edge %s is ready at %s\n' "$version" "$destination"
