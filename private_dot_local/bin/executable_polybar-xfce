#!/usr/bin/env bash
set -u

config="${XDG_CONFIG_HOME:-$HOME/.config}/polybar/config.ini"

if pgrep -u "$(id -u)" -x polybar >/dev/null 2>&1; then
    exit 0
fi

mapfile -t monitors < <(polybar --list-monitors 2>/dev/null | awk -F: 'NF {gsub(/^[[:space:]]+|[[:space:]]+$/, "", $1); print $1}')

if ((${#monitors[@]} == 0)); then
    polybar --config="$config" main &
else
    first_monitor=1
    for monitor in "${monitors[@]}"; do
        bar=main
        if (( first_monitor )); then
            bar=main-tray
            first_monitor=0
        fi
        MONITOR="$monitor" polybar --config="$config" "$bar" &
    done
fi

wait
