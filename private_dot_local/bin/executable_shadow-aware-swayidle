#!/usr/bin/env python3
"""Run swayidle only while Shadow PC is not running in a Niri session."""

from __future__ import annotations

import json
import os
import signal
import subprocess
import sys
import time
from typing import Any, Optional

POLL_INTERVAL = 1.0
QUERY_TIMEOUT = 2.0
LOCK_COMMAND = "swaylock -f -c 192324"
SHADOW_WINDOWS = {"Shadow PC", "Shadow PC - Display"}
SHADOW_PROCESSES = ("ShadowPCDisplay", "shadow-launcher")

idle_process: Optional[subprocess.Popen[bytes]] = None


def require_niri() -> None:
    desktop = ":".join(
        filter(
            None,
            (
                os.environ.get("XDG_CURRENT_DESKTOP"),
                os.environ.get("XDG_SESSION_DESKTOP"),
            ),
        )
    ).lower()

    if not (os.environ.get("NIRI_SOCKET") or "niri" in desktop):
        raise RuntimeError("a Niri session was not detected")


def swayidle_command() -> list[str]:
    return [
        "swayidle",
        "-w",
        "timeout",
        "600",
        LOCK_COMMAND,
        "timeout",
        "601",
        "niri msg action power-off-monitors",
        "resume",
        "before-sleep",
        LOCK_COMMAND,
    ]


def query_windows() -> list[dict[str, Any]]:
    result = subprocess.run(
        ["niri", "msg", "-j", "windows"],
        check=True,
        capture_output=True,
        text=True,
        timeout=QUERY_TIMEOUT,
    )
    windows = json.loads(result.stdout)
    if not isinstance(windows, list):
        raise TypeError("compositor window query did not return a list")
    return [window for window in windows if isinstance(window, dict)]


def window_is_shadow(window: dict[str, Any]) -> bool:
    return any(window.get(field) in SHADOW_WINDOWS for field in ("app_id", "title"))


def shadow_process_is_running() -> bool:
    return any(
        subprocess.run(
            ["pgrep", "-x", process_name],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        ).returncode
        == 0
        for process_name in SHADOW_PROCESSES
    )


def shadow_is_running() -> bool:
    """Return whether Shadow has a Niri window or native process."""
    try:
        windows = query_windows()
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError, TypeError, ValueError):
        # Do not enable the lock manager while compositor state is unavailable.
        return True

    return any(window_is_shadow(window) for window in windows) or shadow_process_is_running()


def start_idle(command: list[str]) -> None:
    global idle_process

    if idle_process is not None and idle_process.poll() is None:
        return

    idle_process = subprocess.Popen(command)
    print("Shadow PC is not running; swayidle enabled", file=sys.stderr, flush=True)


def stop_idle() -> None:
    global idle_process

    if idle_process is None:
        return

    if idle_process.poll() is None:
        idle_process.terminate()
        try:
            idle_process.wait(timeout=2)
        except subprocess.TimeoutExpired:
            idle_process.kill()
            idle_process.wait()

    idle_process = None
    print("Shadow PC is running; swayidle disabled", file=sys.stderr, flush=True)


def stop_on_signal(signum: int, _frame: object) -> None:
    stop_idle()
    raise SystemExit(128 + signum)


def main() -> int:
    try:
        require_niri()
    except RuntimeError as error:
        print(f"shadow-aware-swayidle: {error}", file=sys.stderr)
        return 1

    command = swayidle_command()
    if sys.argv[1:] == ["--check"]:
        state = "running" if shadow_is_running() else "not running"
        print(f"shadow={state}")
        print("swayidle=" + repr(command))
        return 0
    if sys.argv[1:]:
        print("usage: shadow-aware-swayidle [--check]", file=sys.stderr)
        return 2

    for signal_number in (signal.SIGINT, signal.SIGTERM):
        signal.signal(signal_number, stop_on_signal)

    try:
        while True:
            if shadow_is_running():
                stop_idle()
            else:
                start_idle(command)
            time.sleep(POLL_INTERVAL)
    finally:
        stop_idle()

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
