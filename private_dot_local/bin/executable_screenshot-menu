#!/usr/bin/env bash

set -euo pipefail

script_name=${0##*/}
screenshot_dir="$HOME/Screenshots"

notify_error() {
    local message=$1

    printf '%s: %s\n' "$script_name" "$message" >&2
    if command -v notify-send >/dev/null 2>&1; then
        notify-send --urgency=critical 'Screenshot' "$message" >/dev/null 2>&1 || true
    fi
}

require_command() {
    if ! command -v "$1" >/dev/null 2>&1; then
        notify_error "Required command not found: $1"
        exit 1
    fi
}

for command in fuzzel niri; do
    require_command "$command"
done

choices=(
    'Fullscreen'
    'Select area with cursor'
    'Focused window'
)

if ! selected_index=$(
    printf '%s\n' "${choices[@]}" |
        fuzzel --dmenu --only-match --index --minimal-lines \
            --lines="${#choices[@]}" --prompt='Screenshot: '
); then
    # Escape cancels the menu.
    exit 0
fi

case "$selected_index" in
    0)
        action=(screenshot-screen --show-pointer true)
        ;;
    1)
        action=(screenshot --show-pointer true)
        ;;
    2)
        action=(screenshot-window --show-pointer false)
        ;;
    *)
        notify_error "Invalid menu selection: $selected_index"
        exit 1
        ;;
esac

if ! mkdir -p -- "$screenshot_dir"; then
    notify_error "Could not create screenshot directory: $screenshot_dir"
    exit 1
fi

screenshot_path="$screenshot_dir/Screenshot from $(date '+%Y-%m-%d %H-%M-%S-%3N').png"

if ! niri msg action "${action[@]}" --path "$screenshot_path"; then
    notify_error "Failed to take screenshot"
    exit 1
fi
