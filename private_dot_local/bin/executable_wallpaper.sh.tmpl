#!/usr/bin/env bash

sleep 2

# wallpapers="$HOME/Wallpapers"
wallpaper="$HOME/Wallpapers/snowymountainnord.png"

if command -v awww &> /dev/null; then
	if ! pgrep -x "awww-daemon" > /dev/null; then
		nohup awww-daemon >/dev/null 2>&1 &
	fi
	sleep 1 && awww img "$wallpaper"
elif command -v swaybg &> /dev/null; then
	echo "awww command not found; falling back to swaybg."
	nohup swaybg -i "$wallpaper" >/dev/null 2>&1 &
else
	echo "Neither awww nor swaybg was found. Please install one to set the wallpaper."
	exit 1
fi

